# Puerto en el que escucha el servidor
PORT=8080

# Entorno de ejecucion: development | production
NODE_ENV=development

# Cadena de conexion a MongoDB.
# Si se deja vacia, el servidor igual levanta y los endpoints responden sin base de datos.
MONGO_URL=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/eventos?retryWrites=true&w=majority

# Secreto para firmar los JWT.
# Generar uno propio, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio

# Tiempo de expiracion del JWT (formato de la libreria jsonwebtoken: 1h, 30m, 7d, etc.)
JWT_EXPIRES_IN=1h

# --- Envio de emails (Nodemailer) ---
# Credenciales del servidor SMTP que envia el mail de confirmacion de inscripcion.
# Nunca se hardcodean en el codigo: se leen solo desde aca.
# Si se dejan vacias, la inscripcion igual funciona y el envio se saltea con un aviso por consola.

# Host del servidor SMTP (ej: smtp.gmail.com, smtp.ethereal.email)
MAIL_HOST=smtp.gmail.com

# Puerto SMTP. 465 usa TLS directo; 587 arranca en claro y sube a TLS con STARTTLS.
MAIL_PORT=587

# Usuario / casilla desde la que se envia
MAIL_USER=tu_cuenta@gmail.com

# Contrasena de aplicacion (en Gmail NO va la contrasena de la cuenta:
# hay que generar una "App Password" con la verificacion en dos pasos activada)
MAIL_PASS=reemplazar_por_la_password_de_aplicacion

# Remitente que ve el destinatario. Si se deja vacio, se usa MAIL_USER.
MAIL_FROM=Eventos Deportivos <tu_cuenta@gmail.com>
